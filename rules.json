{
 "version": 2,
 "approval_ttl_seconds": 600,
 "rules": [
  {
   "id": "self-protect",
   "tools": [
    "Bash"
   ],
   "approvable": false,
   "pattern": "cg-approve|\\.claude-guardrail",
   "why": "The agent may not touch the guardrail itself or its approval tool."
  },
  {
   "id": "self-protect",
   "tools": [
    "Edit",
    "Write",
    "MultiEdit"
   ],
   "field": "file_path",
   "approvable": false,
   "pattern": "(^|/)\\.claude-guardrail(/|$)|(^|/)\\.local/bin/cg-(approve|receipts)$",
   "why": "The agent may not edit the guardrail's own files (rules, approvals, scripts)."
  },
  {
   "id": "claude-settings",
   "tools": [
    "Edit",
    "Write",
    "MultiEdit"
   ],
   "field": "file_path",
   "approvable": true,
   "pattern": "(^|/)\\.claude/settings(\\.local)?\\.json$",
   "why": "Editing Claude settings could switch the hooks off."
  },
  {
   "id": "claude-settings",
   "tools": [
    "Bash"
   ],
   "approvable": true,
   "pattern": "(>|\\btee\\b|\\bsed\\s+-[a-zA-Z]*i|\\bperl\\s+-[a-zA-Z]*i|\\bcp\\b|\\bmv\\b|\\bln\\b|\\brm\\b|\\btruncate\\b)[^;&|\\n]*\\.claude/settings(\\.local)?\\.json",
   "why": "Shell command that may overwrite Claude settings and switch the hooks off."
  },
  {
   "id": "git-push-protected",
   "tools": [
    "Bash"
   ],
   "approvable": true,
   "pattern": "\\bgit\\s+(?:-[cC]\\s+\\S+\\s+)*push\\b[^;&|\\n]*(\\s--force(-with-lease)?\\b|\\s-f\\b|\\s\\+\\S|[\\s:+](main|master|production|prod)(?![\\w./-]))",
   "why": "Force push, or push to main/master/production."
  },
  {
   "id": "rm-recursive-force",
   "tools": [
    "Bash"
   ],
   "approvable": true,
   "pattern": "\\brm\\s+(?:[^;&|\\n]*\\s)?(-[a-zA-Z]*([rR][a-zA-Z]*f|f[a-zA-Z]*[rR])[a-zA-Z]*\\b|--recursive\\b[^;&|\\n]*--force\\b|--force\\b[^;&|\\n]*--recursive\\b)|(?<![\\w-])rm\\s(?=(?:[^;&|\\n]*\\s)?(?:-[a-zA-Z]*[rR]|--recursive\\b))(?=(?:[^;&|\\n]*\\s)?(?:-[a-zA-Z]*f|--force\\b))",
   "why": "Recursive force delete."
  }
 ]
}
