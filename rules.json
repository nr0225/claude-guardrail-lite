{
 "version": 3,
 "approval_ttl_seconds": 600,
 "rules": [
  {
   "id": "claude-settings",
   "tools": [
    "Edit",
    "Write",
    "MultiEdit",
    "NotebookEdit"
   ],
   "field": "file_path",
   "approvable": true,
   "pattern": "(^|/)\\.claude/settings(\\.local)?\\.json$",
   "why": "Editing Claude settings could switch the hooks off."
  },
  {
   "id": "claude-settings",
   "tools": [
    "Bash"
   ],
   "approvable": true,
   "pattern": "(?:>|\\btee\\b|\\bsed\\s+(?:-[a-zA-Z]*\\s+)*-[a-zA-Z]*i|\\bperl\\s+-[a-zA-Z]*i|\\bcp\\b|\\bmv\\b|\\bln\\b|\\binstall\\b|\\bdd\\b|\\brsync\\b|\\btruncate\\b|\\brm\\b)[^;&|\\n]{0,400}\\.claude/settings(\\.local)?\\.json|open\\(\\s*[^()]{0,400}\\.claude/settings(\\.local)?\\.json[^()]{0,400},\\s*[wa+]",
   "why": "Shell command that may overwrite Claude settings and switch the hooks off.",
   "requires": [
    "settings"
   ]
  },
  {
   "id": "git-push-protected",
   "tools": [
    "Bash"
   ],
   "approvable": true,
   "pattern": "\\bgit\\b(?:\\s+(?:-[cC]\\s+\\S+|--(?:git-dir|work-tree|namespace|exec-path|config-env)\\s+\\S+|-{1,2}\\w[\\w-]*(?:=\\S*)?)){0,20}\\s+push\\b[^;&|\\n]{0,400}(\\s--force(-with-lease|-if-includes)?\\b|\\s-[a-zA-Z]*f[a-zA-Z]*\\b|\\s--mirror\\b|\\s\\+\\S|(?:[\\s:+]|refs/heads/)(main|master|production|prod)(?![\\w./-]))",
   "why": "Force push, mirror push, or push to main/master/production.",
   "requires": [
    "git"
   ]
  },
  {
   "id": "rm-recursive-force",
   "tools": [
    "Bash"
   ],
   "approvable": true,
   "pattern": "\\brm\\s+(?:[^;&|\\n]{0,400}\\s)?(-[a-zA-Z]*([rR][a-zA-Z]*f|f[a-zA-Z]*[rR])[a-zA-Z]*\\b|--recursive\\b[^;&|\\n]{0,400}--force\\b|--force\\b[^;&|\\n]{0,400}--recursive\\b)|(?<![\\w-])rm\\s(?=(?:[^;&|\\n]{0,400}\\s)?(?:-[a-zA-Z]*[rR]|--recursive\\b))(?=(?:[^;&|\\n]{0,400}\\s)?(?:-[a-zA-Z]*f|--force\\b))|\\bfind\\b[^;&|\\n]{0,400}\\s-delete\\b",
   "why": "Recursive force delete.",
   "requires": [
    "rm",
    "find"
   ]
  },
  {
   "id": "opaque-shell",
   "tools": [
    "Bash"
   ],
   "approvable": true,
   "pattern": "\\beval\\b|\\b(base64|base32|xxd|openssl)\\b[^;&\\n]{0,400}\\s(-d|--decode|-D|-r)\\b[^;&\\n]{0,400}\\|\\s*(sudo\\s+)?\\S*\\b(sh|bash|zsh|dash|ksh|python[0-9.]*|perl|ruby|node)\\b|\\|\\s*(sudo\\s+)?(env\\s+)?(ba|z|da|k)?sh\\b(\\s+-s)?\\s*($|[;&|)])|\\$\\([^()]{0,400}\\b(base64|base32|xxd|printf|rev)\\b(?!-)[^()]{0,400}\\)|\\$'[^']*\\\\(x[0-9a-fA-F]|[0-7]{1,3}|u[0-9a-fA-F])|\\bpython[0-9.]*\\b[^|;&]{0,400}\\b(chr|fromhex|b64decode|unhexlify|codecs\\.decode|exec)\\s*\\(|\\bfind\\s+(~|\\$HOME|\\$\\{HOME\\}|/|/home/[^/\\s]+|/Users/[^/\\s]+|/root)/?\\s[^;&|\\n]{0,400}\\s-(exec|execdir|ok|okdir|delete|fprint|fprintf|fls)\\b|\\bshopt\\s+-s\\s+[^;&|\\n]{0,400}\\b(dotglob|globstar)\\b|\\bGLOBIGNORE=|\\bsetopt\\s+[^;&|\\n]{0,400}glob_?dots",
   "why": "The command builds or decodes what it runs at run time, or runs a command over every file under your home or root directory, so the guardrail cannot tell what it touches. A human should look at it first."
  },
  {
   "id": "guardrail-reference",
   "tools": [
    "Edit",
    "Write",
    "MultiEdit",
    "NotebookEdit"
   ],
   "approvable": true,
   "ignore_case": true,
   "pattern": "\\.claude-guardrail|cg-approve|cg_common|CLAUDE_GUARDRAIL_",
   "why": "The file being written names the guardrail's own files or approval tool (for example a script that would edit them). A human should look at it first."
  }
 ]
}