#!/usr/bin/env python3
"""Print the last N guardrail decisions (default 20)."""
import json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from cg_common import RECEIPTS
n = int(sys.argv[1]) if len(sys.argv) > 1 else 20
try:
    lines = open(RECEIPTS, encoding="utf-8").read().splitlines()[-n:]
except FileNotFoundError:
    print("no receipts yet"); sys.exit(0)
for line in lines:
    e = json.loads(line)
    print("%s  %-8s %-20s %-6s %s" % (e.get("ts"), e.get("decision"), e.get("rule", "-"), e.get("code", ""), (e.get("subject") or "")[:80]))
